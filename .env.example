# Do not commit real credentials. This file contains only safe local defaults.
POSTGRES_DB=job_platform
POSTGRES_USER=job_platform
POSTGRES_PASSWORD=change-me-before-use
RABBITMQ_USER=job_platform
RABBITMQ_PASSWORD=change-me-before-use
JWT_SIGNING_KEY=replace-with-a-long-random-development-value
WEB_PORT=8088
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password
UPLOAD_MAX_SIZE=10MB
UPLOAD_MAX_SIZE_BYTES=10485760
FILE_ASSET_OUTPUT_MAX_SIZE_BYTES=52428800
# Optional deployment-managed comma-separated operator accounts. Never expose this in the browser.
OPERATOR_EMAILS=
LOGIN_ATTEMPTS_PER_EMAIL=10
LOGIN_ATTEMPTS_PER_ADDRESS=30
LOGIN_RATE_LIMIT_WINDOW=PT1M
MAX_WAITING_JOBS=5000
MAX_LOCAL_STORAGE_USED_PERCENT=80
# Keep local stand-in report, email, and notification jobs visibly asynchronous.
WORKER_PLACEHOLDER_HANDLER_MINIMUM_DURATION=PT1S
WORKER_PLACEHOLDER_HANDLER_MAXIMUM_DURATION=PT2S
